# Backend (NestJS) — copy to backend/.env and fill in real values. Never commit backend/.env.
# Template only; placeholders below are not production secrets.

NODE_ENV=development
PORT=3000

# MySQL (local dev or AWS RDS)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_mysql_username
DATABASE_PASSWORD=your_mysql_password
DATABASE_NAME=compliance_tracking

# E2e tests use a separate database (default: {DATABASE_NAME}_e2e). Auto-created on first npm run test:e2e when MySQL user has CREATE privilege.
E2E_DATABASE_NAME=compliance_tracking_e2e

# JWT (generate: openssl rand -base64 48)
JWT_SECRET=your_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=1h

# Password hashing (bcrypt work factor)
BCRYPT_ROUNDS=12

# Compliance business rules
COMPLIANCE_EXPIRING_BUFFER_DAYS=30
COMPLIANCE_TIMEZONE=Asia/Colombo

# CORS — comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Swagger UI (non-production only): http://localhost:3000/api/docs

# Seed script — dashboard admin (created by npm run seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=your_admin_password

# Seed script — expiry job service account (same login flow as dashboard)
SEED_SERVICE_USERNAME=expiry-job
SEED_SERVICE_PASSWORD=your_service_account_password
