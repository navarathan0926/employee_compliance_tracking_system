# =============================================================================
# Employee Compliance Tracking System — environment variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (NestJS) — backend/.env or repo root depending on your setup
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# MySQL (local dev or AWS RDS)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=compliance_app
DATABASE_PASSWORD=change_me
DATABASE_NAME=compliance_tracking

# JWT (generate secret: openssl rand -base64 48)
JWT_SECRET=replace_with_random_base64_string_min_32_chars
JWT_EXPIRES_IN=1h

# Password hashing (bcrypt work factor; 12 is a reasonable default)
BCRYPT_ROUNDS=12

# Compliance business rules
COMPLIANCE_EXPIRING_BUFFER_DAYS=30
COMPLIANCE_TIMEZONE=Asia/Colombo

# CORS — comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Seed script — initial admin user (created by npm run seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_admin_password

# Seed script — expiry job service account (same login flow as dashboard)
SEED_SERVICE_USERNAME=expiry-job
SEED_SERVICE_PASSWORD=change_me_service_password

# -----------------------------------------------------------------------------
# Expiry job (Python) — expiry-job/.env
# -----------------------------------------------------------------------------

# NestJS API base URL (no trailing slash)
API_BASE_URL=http://localhost:3000/api

# Service account credentials (must match seeded user above)
SERVICE_ACCOUNT_USERNAME=expiry-job
SERVICE_ACCOUNT_PASSWORD=change_me_service_password

# Must match backend value
COMPLIANCE_EXPIRING_BUFFER_DAYS=30
COMPLIANCE_TIMEZONE=Asia/Colombo

# HTTP client
API_REQUEST_TIMEOUT_SECONDS=30

# AWS — use LocalStack locally; real AWS in deployment
# Leave AWS_ENDPOINT_URL unset in production (uses real AWS)
AWS_REGION=ap-southeast-1
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# EventBridge (names only — no account IDs or ARNs in code)
EVENTBRIDGE_BUS_NAME=compliance-events
EVENTBRIDGE_SOURCE=compliance.expiry-job
EVENTBRIDGE_DETAIL_TYPE=compliance.expiry-evaluation.completed

# SQS queue the EventBridge rule routes to (for infra setup / LocalStack)
SQS_QUEUE_NAME=compliance-lifecycle-events

# Optional: skip EventBridge publish when testing core expiry logic locally
# SKIP_EVENT_PUBLISH=true

# -----------------------------------------------------------------------------
# Frontend (SvelteKit) — frontend/.env
# -----------------------------------------------------------------------------

# Public API URL (exposed to browser — no secrets here)
PUBLIC_API_BASE_URL=http://localhost:3000/api
